# Endurecimiento frente a ataques a la cadena de suministro. Ver CLAUDE.md.

# Un paquete publicado hace menos de siete días no se instala. La mayoría de las
# versiones comprometidas se detectan y despublican en las primeras horas; esta
# cuarentena hace que la ventana de exposición pase de minutos a una semana.
# Para saltarla puntualmente: pnpm install --minimum-release-age=0
minimum-release-age=10080

# Excepciones, y el motivo por el que no debilitan nada:
#
# El proyecto va contra Next 16.3.3, publicado el 2026-08-25 —dos días antes de
# poner esto—, así que la cuarentena bloquearía el propio framework. Pero `next`
# está clavado a una versión exacta en package.json, no a un rango: no puede
# derivar sola a una versión nueva sin que alguien edite el fichero a mano. Esa
# fijación exacta ya es la protección; la cuarentena no añade nada encima.
# `@next/swc-*` y `sharp` son los binarios nativos que acompañan a `next` y su
# versión la marca él, no un rango nuestro.
#
# ▲ La cuarentena sí protege todo lo demás, que es donde vive el riesgo real:
# las dependencias transitivas con rango `^` que pueden saltar a una versión
# publicada hace diez minutos sin que nadie lo pida.
minimum-release-age-exclude[]=next
minimum-release-age-exclude[]=@next/swc-linux-x64-gnu
minimum-release-age-exclude[]=@next/swc-linux-x64-musl
minimum-release-age-exclude[]=@next/swc-linux-arm64-gnu
minimum-release-age-exclude[]=@next/swc-linux-arm64-musl
minimum-release-age-exclude[]=@next/swc-darwin-arm64
minimum-release-age-exclude[]=@next/swc-darwin-x64
minimum-release-age-exclude[]=@next/swc-win32-x64-msvc
minimum-release-age-exclude[]=@next/swc-win32-arm64-msvc
minimum-release-age-exclude[]=eslint-config-next
minimum-release-age-exclude[]=sharp

# Sin esto, `pnpm add` fija "^x.y.z" y una instalación futura puede traer una
# versión menor que nadie revisó. Con rango exacto, lo que se instala es lo que
# dice el lockfile y nada más.
save-exact=true
